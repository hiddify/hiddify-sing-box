{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen_port": 7897
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "masque",
      "tag": "masque-out",
      "use_http2": false,
      "use_ipv6": false,
      "profile": {
        "detour": "direct",
        "id": "",
        "auth_token": ""
      },
      "udp_timeout": "5m0s",
      "udp_keepalive_period": "30s",
      "udp_initial_packet_size": 0,
      "reconnect_delay": "5s",
      "insecure": false,
      "fragment": false,
      "record_fragment": false,
      "kernel_tx": false,
      "kernel_rx": false
    }
  ],
  "route": {
    "final": "masque-out",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
