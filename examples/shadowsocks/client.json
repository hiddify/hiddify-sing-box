{
  "log": {
    "level": "trace"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "mixed-in",
      "listen_port": 7897
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "shadowsocks",
      "tag": "ss-out",
      "server": "127.0.0.1",
      "server_port": 8388,
      "method": "chacha20-ietf-poly1305",
      "password": "your-password",
      // "plugin": "obfs-local",
      // "plugin_opts": "obfs=http;obfs-host=example.com"
    }
  ],
  "route": {
    "final": "ss-out",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
