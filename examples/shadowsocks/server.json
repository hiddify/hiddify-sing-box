{
  "log": {
    "level": "trace"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "inbounds": [
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "0.0.0.0",
      "listen_port": 8388,
      "method": "chacha20-ietf-poly1305",
      "password": "your-password",
      // "obfs_mode": "http",
      // "obfs_host": "example.com"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
