{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wireguard-out",
      "mtu": 1408,
      "address": [
        "10.0.0.2/32"
      ],
      "private_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
      "listen_port": 10000,
      "peers": [
        {
          "address": "example.com",
          "port": 10001,
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
          "allowed_ips": [
            "0.0.0.0/0"
          ],
          "reserved": "AAAA"
        }
      ],
      "udp_timeout": "5m0s",
      "preallocated_buffers_per_pool": 256,
      "disable_pauses": true
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen_port": 7897
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "wireguard-out",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
