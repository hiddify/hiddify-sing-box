{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "default"
      }
    ]
  },
  "inbounds": [
    {
      "type": "snell",
      "tag": "snell-in",
      "listen": "0.0.0.0",
      "listen_port": 4400,
      "psk": "my-pre-shared-key",
      "version": 4,
      "obfs_mode": "http",
      "obfs_host": "example.com"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "default",
    "auto_detect_interface": true
  }
}
